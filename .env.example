# Public URL of this app (what you type in the browser / what your proxy serves)
BASE_URL=http://localhost:8080

# Pocket ID: its base URL is its OIDC issuer.
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme

# Where Pocket ID itself is served, if using the bundled compose service
POCKET_ID_URL=http://localhost:1411

# true once behind HTTPS
COOKIE_SECURE=false

# Local dev without any identity provider (auto-login as a dev user).
# AUTH_DISABLED=true
